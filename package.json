{
  "name": "arefmozafari.com",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "verify": "npm run check && npm run test && npm run build",
    "astro": "astro",
    "prebuild": "node tools/check-assets.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "build:demo": "cd demo && flutter build web --release --base-href=/demo/ --no-web-resources-cdn && rm -rf ../public/demo && cp -r build/web ../public/demo && npm run prune:demo",
    "prune:demo": "rm -rf public/demo/canvaskit/*.symbols public/demo/canvaskit/skwasm* public/demo/canvaskit/wimp* public/demo/canvaskit/webparagraph"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
