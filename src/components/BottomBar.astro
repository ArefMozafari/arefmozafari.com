---
import { SITE } from '../site';
---

<nav class="bottom-bar" aria-label="Quick actions" transition:persist="bottom-bar">
  <a class="primary" href={`mailto:${SITE.email}`}>
    Email me
  </a>
  <a class="secondary" href={SITE.resumePath} download={SITE.resumeFileName}>
    Résumé
  </a>
</nav>

<style>
  .bottom-bar {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 3;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter) calc(var(--space-4) + env(safe-area-inset-bottom));
    background: var(--color-canvas);
    border-top: var(--rule-strong);
  }

  /* Both buttons carry the same rule, so they are the same height and their labels sit on the
     same centre line; the filled one draws its rule in its own colour. */
  .bottom-bar a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    border: var(--rule-strong);
    border-radius: var(--radius-block);
    text-decoration: none;
    font-weight: 800;
    font-size: var(--text-small);
  }

  .primary {
    background: var(--color-ink);
    color: var(--color-block-ink);
  }

  @media (max-width: 767px) {
    .bottom-bar {
      display: flex;
    }
  }
</style>
