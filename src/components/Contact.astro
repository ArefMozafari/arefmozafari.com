---
import { SITE } from '../site';
---

<div class="contact">
  <h2 class="heading">Let's talk.</h2>
  <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  <a href={SITE.linkedin} target="_blank" rel="noopener">
    LinkedIn: aref-mozafari
  </a>
  <a href={SITE.github} target="_blank" rel="noopener">
    GitHub: arefmozafari
  </a>
  <a href={SITE.resumePath} download={SITE.resumeFileName}>
    Résumé (PDF, one page)
  </a>
</div>

<style>
  .contact {
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: var(--rule-strong);
  }

  .heading {
    margin-bottom: var(--space-4);
    font-size: var(--text-contact);
    font-weight: 800;
    letter-spacing: var(--tracking-name);
    line-height: var(--leading-display);
  }

  .contact a {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: var(--space-2) 0;
    font-size: var(--text-contact-link);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset-large);
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .heading {
      font-size: var(--text-contact-phone);
    }

    .contact a {
      font-size: var(--text-caption);
    }
  }
</style>
