---
import PhoneFrame from './PhoneFrame.astro';

/// The real flutter_pw_validator widget, compiled to web, inside the phone chrome.
/// Without JavaScript the visitor sees a static screenshot instead.
interface Props {
  fallbackAlt: string;
}

const { fallbackAlt } = Astro.props;
// The explicit file name works on the dev server too, which does not resolve directory URLs.
const DEMO_PATH = '/demo/index.html';
const FALLBACK_PATH = '/demo-fallback.png';
---

<PhoneFrame class="demo">
  <iframe src={DEMO_PATH} title="Flutter Password Validator demo" loading="lazy" data-demo></iframe>
  <noscript>
    <img src={FALLBACK_PATH} alt={fallbackAlt} width="170" height="330" />
  </noscript>
</PhoneFrame>

<style>
  :global(.demo) {
    border-color: var(--color-ink);
  }

  /* With scripting on, the iframe fills the screen; without it the noscript image does. */
  noscript img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
