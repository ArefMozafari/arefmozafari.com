---
/// Browser-window chrome around a desktop screenshot. The screen is the default slot.
---

<div class="window">
  <slot />
</div>

<style>
  .window {
    position: absolute;
    right: var(--space-7);
    top: var(--space-6);
    width: 60%;
    max-width: 420px;
    height: 100%;
    overflow: hidden;
    border: var(--rule-block);
    border-bottom: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--color-block-ink);
  }

  .window :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 767px) {
    .window {
      right: var(--space-4);
      top: var(--space-4);
      width: 55%;
    }
  }
</style>
