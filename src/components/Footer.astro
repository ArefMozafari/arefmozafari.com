---
import { SITE } from '../site';

const year = new Date().getFullYear();
---

<footer class="footer mono muted">
  <span>
    Aref Mozafari · {year} ·{' '}
    <span lang="fa" dir="rtl">
      {SITE.nameFa}
    </span>
  </span>
  <a href={SITE.repo} target="_blank" rel="noopener">
    Built by hand · source on GitHub ↗
  </a>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    font-size: var(--text-label);
  }

  /* The Persian name wraps as one unit, never split across lines. */
  .footer [lang='fa'] {
    white-space: nowrap;
  }

  .footer a {
    text-decoration: none;
  }

  /* The line only: the shorthand would reset the colour the global link rules set. */
  .footer a:hover {
    text-decoration-line: underline;
  }

  @media (max-width: 767px) {
    .footer {
      flex-direction: column;
    }
  }
</style>
