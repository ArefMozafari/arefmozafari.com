---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import type { Section } from '../sections';
import { SITE } from '../site';

interface Props {
  sections: readonly Section[];
}

const { sections } = Astro.props;
---

<header class="mobile-header">
  <a class="home" href="#top" aria-label="Top of page">
    <Image src={portrait} alt="" width={80} class="portrait" />
  </a>
  <span class="status mono muted">Open to remote roles</span>
  <details class="menu">
    <summary>Menu</summary>
    <nav aria-label="Sections">
      {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
      <a href={`mailto:${SITE.email}`}>Email</a>
    </nav>
  </details>
</header>

<style>
  .mobile-header {
    display: none;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--gutter);
    font-size: var(--text-label);
  }

  .home {
    display: block;
    width: var(--portrait-small);
    height: var(--portrait-small);
    overflow: hidden;
    border-radius: var(--space-1);
    background: var(--color-block);
  }

  .home :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .status {
    flex: 1;
  }

  .menu summary {
    cursor: pointer;
    font-weight: 800;
    font-size: var(--text-small);
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    right: var(--gutter);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-4);
    background: var(--color-canvas);
    border: var(--rule-strong);
    font-size: var(--text-caption);
    font-weight: 800;
  }

  .menu nav a {
    text-decoration: none;
  }

  @media (max-width: 1023px) {
    .mobile-header {
      display: flex;
    }
  }
</style>
