---
import type { RepoCounts } from '../lib/github';
import type { PackageScore } from '../lib/pubdev';

export type OpenSourceRow = {
  name: string;
  description: string;
  url: string;
  counts: RepoCounts | null;
  score: PackageScore | null;
  note?: string;
};

interface Props {
  rows: OpenSourceRow[];
}

const { rows } = Astro.props;

/// GitHub counts win; pub.dev score is the fallback; a note is the last resort.
function countText(row: OpenSourceRow): string {
  if (row.counts) {
    return `${row.counts.stars} ★ · ${row.counts.forks} forks`;
  }
  if (row.score) {
    return `${row.score.likes} likes · ${row.score.points} pts`;
  }
  return row.note ?? '';
}
---

<ul class="repos">
  {
    rows.map((row) => (
      <li class="repo">
        <div>
          <a class="mono name" href={row.url} target="_blank" rel="noopener">
            {row.name}
          </a>
          <p class="muted description">{row.description}</p>
        </div>
        <span class="mono muted count">{countText(row)}</span>
      </li>
    ))
  }
</ul>

<style>
  .repos {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: var(--hairline);
  }

  .repo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: var(--hairline);
    font-size: var(--text-small);
  }

  .name {
    font-size: var(--text-note);
    font-weight: 500;
  }

  .description {
    margin-top: var(--space-1);
    font-size: var(--text-note);
  }

  .count {
    font-size: var(--text-note);
    white-space: nowrap;
    text-align: right;
  }

  @media (max-width: 767px) {
    .repo {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .count {
      text-align: left;
    }
  }
</style>
