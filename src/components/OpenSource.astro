---
import type { RepoCounts } from '../lib/github';
import type { PackageScore } from '../lib/pubdev';

export type OpenSourceRow = {
  name: string;
  description: string;
  url: string;
  counts: RepoCounts | null;
  score: PackageScore | null;
  note?: string;
};

interface Props {
  rows: OpenSourceRow[];
}

const { rows } = Astro.props;

/// "1 fork", "46 forks": the unit agrees with the count.
function plural(count: number, unit: string): string {
  return `${count} ${unit}${count === 1 ? '' : 's'}`;
}

/// Stars and likes together for a published package, stars and forks for a repo,
/// likes and points when only pub.dev answered, the note when nothing else applies.
/// A repo nobody has starred yet shows no count at all.
function countText(row: OpenSourceRow): string {
  const hasStars = row.counts !== null && row.counts.stars > 0;
  if (hasStars && row.score) {
    return `${row.counts!.stars} ★ · ${plural(row.score.likes, 'like')}`;
  }
  if (hasStars) {
    return `${row.counts!.stars} ★ · ${plural(row.counts!.forks, 'fork')}`;
  }
  if (row.score) {
    return `${plural(row.score.likes, 'like')} · ${plural(row.score.points, 'pt')}`;
  }
  return row.note ?? '';
}
---

<ul class="repos">
  {rows.map((row) => (
    <li class="repo">
      <div>
        <a class="mono name" href={row.url} target="_blank" rel="noopener">
          {row.name}
        </a>
        <p class="muted description">{row.description}</p>
      </div>
      <span class="mono muted count">{countText(row)}</span>
    </li>
  ))}
</ul>

<style>
  .repos {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: var(--hairline);
  }

  .repo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: var(--hairline);
    font-size: var(--text-small);
  }

  .name {
    font-size: var(--text-note);
    font-weight: 500;
  }

  .description {
    margin-top: var(--space-1);
    font-size: var(--text-note);
  }

  .count {
    font-size: var(--text-note);
    white-space: nowrap;
    text-align: right;
  }

  @media (max-width: 767px) {
    .repo {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .count {
      text-align: left;
    }
  }
</style>
