---
/// Phone chrome around a screenshot or the live demo. The screen is the default slot.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="screen">
    <slot />
  </div>
</div>

<style>
  .phone {
    position: absolute;
    right: var(--space-8);
    bottom: calc(var(--space-7) * -1);
    width: var(--phone-width);
    height: var(--phone-height);
    padding: 6px;
    border: var(--rule-block);
    border-radius: var(--radius-phone);
    background: var(--color-block);
  }

  .screen {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-phone-screen);
    background: var(--color-block-ink);
  }

  .screen :global(img),
  .screen :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 767px) {
    .phone {
      right: var(--space-5);
      width: var(--phone-width-phone);
      height: var(--phone-height-phone);
      bottom: calc(var(--space-6) * -1);
    }
  }
</style>
