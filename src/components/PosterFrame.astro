---
/// A rounded poster at the right of a block: the store's own card, shown as itself,
/// with no phone chrome around it. The image is the default slot.
---

<div class="poster">
  <slot />
</div>

<style>
  .poster {
    position: absolute;
    right: var(--space-7);
    top: var(--space-5);
    z-index: var(--layer-artifact);
    width: var(--poster-width);
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-poster);
  }

  .poster :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .poster {
      right: var(--space-4);
      top: var(--space-4);
      width: var(--poster-width-phone);
    }
  }
</style>
