---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

/// The posts grid, newest first: two columns from tablet width, then as many columns of at
/// least the post column minimum as the main area fits.
interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const newestFirst = [...posts].sort(
  (first, second) => second.data.date.getTime() - first.data.date.getTime(),
);
---

<div class="posts">
  {newestFirst.map((post) => (
    <PostCard post={post} />
  ))}
</div>

<style>
  .posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6) var(--space-5);
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .posts {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* From here the main area holds two columns of the minimum, so the grid fills itself:
     a third column from 1912px, a fourth from 2416px (sidebar, padding and gaps deducted). */
  @media (min-width: 1440px) {
    .posts {
      grid-template-columns: repeat(auto-fill, minmax(var(--post-column-min), 1fr));
    }
  }
</style>
