---
/**
 * A mono, uppercase section label with an optional quiet note on the right. The note is a
 * sibling of the heading, not part of it, so assistive readers announce the title alone.
 * `sign` puts this section's gold mark, a small dot, in front of the title.
 */
interface Props {
  title: string;
  note?: string;
  sign?: boolean;
}

const { title, note, sign = false } = Astro.props;
---

<div class="section-label">
  <h2 class="label">
    <span class:list={{ 'sign-dot': sign }}>{title}</span>
  </h2>
  {note && <p class="label note">{note}</p>}
</div>

<style>
  .section-label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-9) 0 var(--space-3);
  }

  /* A label, not a display heading: the browser's bold for h2 is taken back. */
  .section-label h2 {
    font-weight: 500;
  }

  .note {
    margin: 0;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 767px) {
    .section-label {
      flex-direction: column;
      gap: var(--space-1);
      margin-top: var(--space-8);
    }
  }
</style>
