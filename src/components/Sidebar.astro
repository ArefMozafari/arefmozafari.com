---
import { Image } from 'astro:assets';
import NameFa from '../assets/name-fa.svg';
import portrait from '../assets/portrait.jpg';
import type { Section } from '../sections';
import { SITE } from '../site';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  years: number;
  sections: readonly Section[];
  /// The homepage owns the h1; inner pages render the name as plain text.
  nameAsHeading?: boolean;
}

const { years, sections, nameAsHeading = true } = Astro.props;
const careerStart = SITE.careerStart.toISOString().slice(0, 10);
const NameTag = nameAsHeading ? 'h1' : 'p';
---

<div class="sidebar">
  <NameTag class="name">
    Aref
    <br />
    Mozafari
  </NameTag>
  <p class="name-fa" lang="fa" dir="rtl">
    <span class="visually-hidden">{SITE.nameFa}</span>
    <NameFa aria-hidden="true" />
  </p>

  <figure class="portrait">
    <Image src={portrait} alt={SITE.name} width={320} densities={[1, 2]} loading="eager" />
  </figure>

  <p class="role muted">
    Senior Mobile Engineer.
    <br />
    Flutter, iOS &amp; Android.
    <br />
    <span data-years data-career-start={careerStart}>
      {years}
    </span>{' '}
    years shipping production apps, SDKs, tools and plugins.
  </p>

  <p class="avail">
    <i aria-hidden="true"></i>Open to remote roles
  </p>

  <nav class="nav" aria-label="Sections">
    {sections.map((section) => (
      <a href={`/#${section.id}`}>{section.label}</a>
    ))}
  </nav>

  <address class="contact muted">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <br />
    <a href={SITE.github} target="_blank" rel="noopener">
      GitHub
    </a>
    {' · '}
    <a href={SITE.linkedin} target="_blank" rel="noopener">
      LinkedIn
    </a>
    {' · '}
    <a href={SITE.resumePath} download={SITE.resumeFileName}>
      Résumé
    </a>
  </address>
  <div class="scheme">
    <ThemeSwitch />
  </div>
</div>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* The surname is wider than the column on purpose: it runs over the hairline into the
     main area. Keep it on one line so the overrun is a move, not a wrap. */
  .name {
    position: relative;
    z-index: var(--layer-label);
    white-space: nowrap;
    font-size: var(--text-name);
    font-weight: 800;
    letter-spacing: var(--tracking-name);
    line-height: var(--leading-name);
  }

  /* The Persian name is five glyphs, drawn as paths so no Arabic font is downloaded for
     them; the text itself stays in the markup for crawlers and screen readers. */
  .name-fa {
    margin: var(--space-1) 0 var(--space-5);
    color: var(--color-gold-deep);
    text-align: left;
  }

  .name-fa svg {
    display: block;
    height: var(--text-name-fa);
    width: auto;
  }

  /* A grayscale photo with a translucent gold wash over it; the wash's strength is one token. */
  .portrait {
    position: relative;
    margin: 0 0 var(--space-5);
    aspect-ratio: 4 / 5;
    min-height: var(--portrait-min-height);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-canvas);
  }

  /* The square photo fills the 4:5 figure edge to edge, so no backing ever shows. On a short
     viewport the flex column squeezes the figure, so the photo anchors to its top and the crop
     takes the chest, never the head. */
  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1) contrast(1.05);
  }

  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, var(--color-block-gold), var(--color-gold-deep));
    mix-blend-mode: multiply;
    opacity: var(--portrait-tint);
    pointer-events: none;
  }

  .role {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: max-content;
    margin-top: var(--space-5);
    padding: var(--space-2) var(--space-3);
    border: var(--rule-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-note);
  }

  .avail i {
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-green);
  }

  .nav {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-7);
    font-size: var(--text-nav);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-body);
  }

  .nav a {
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .nav a[aria-current='true'] {
    color: var(--color-gold-deep);
  }

  .contact {
    margin-top: auto;
    padding-top: var(--space-6);
    font-style: normal;
    font-size: var(--text-note);
    line-height: var(--leading-body);
  }

  .contact a {
    text-decoration: none;
  }

  .contact a:hover {
    text-decoration: underline;
  }

  /* Below the desktop breakpoint the compact header carries the portrait, the menu and
     the contact links, so the column keeps only the name, the role and the pill. */
  .scheme {
    margin-top: var(--space-3);
  }

  @media (max-width: 1023px) {
    .portrait,
    .nav,
    .contact,
    .scheme {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .name {
      font-size: var(--text-name-phone);
    }
  }
</style>
