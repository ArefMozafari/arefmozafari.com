---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import type { Section } from '../sections';
import { SITE } from '../site';

interface Props {
  years: number;
  sections: readonly Section[];
  /// The homepage owns the h1; inner pages render the name as plain text.
  nameAsHeading?: boolean;
}

const { years, sections, nameAsHeading = true } = Astro.props;
const careerStart = SITE.careerStart.toISOString().slice(0, 10);
const NameTag = nameAsHeading ? 'h1' : 'p';
---

<div class="sidebar">
  <NameTag class="name">
    Aref
    <br />
    Mozafari
  </NameTag>
  <p class="name-fa" lang="fa" dir="rtl">
    {SITE.nameFa}
  </p>

  <figure class="portrait">
    <Image src={portrait} alt={SITE.name} width={320} densities={[1, 2]} loading="eager" />
  </figure>

  <p class="role muted">
    Senior Mobile Engineer.
    <br />
    Flutter, iOS &amp; Android.
    <br />
    <span data-years data-career-start={careerStart}>
      {years}
    </span>{' '}
    years shipping production apps.
  </p>

  <p class="avail">
    <i aria-hidden="true"></i>Open to remote roles
  </p>

  <nav class="nav" aria-label="Sections">
    {sections.map((section) => (
      <a href={`/#${section.id}`}>{section.label}</a>
    ))}
  </nav>

  <address class="contact muted">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <br />
    <a href={SITE.github} target="_blank" rel="noopener">
      GitHub
    </a>
    {' · '}
    <a href={SITE.linkedin} target="_blank" rel="noopener">
      LinkedIn
    </a>
    {' · '}
    <a href="/cv.pdf">CV</a>
  </address>
</div>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .name {
    font-size: var(--text-name);
    font-weight: 800;
    letter-spacing: var(--tracking-name);
    line-height: var(--leading-name);
  }

  .name-fa {
    margin: var(--space-1) 0 var(--space-5);
    font-family: var(--font-fa), sans-serif;
    font-size: var(--text-name-fa);
    font-weight: 800;
    color: var(--color-gold-deep);
    text-align: left;
    line-height: var(--leading-body);
  }

  /* Charcoal-and-gold duotone: a grayscale photo multiplied over a gold gradient,
     with the halftone grid on top so the portrait belongs to the block system. */
  .portrait {
    position: relative;
    margin: 0 0 var(--space-5);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-block-gold), var(--color-gold-deep));
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }

  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      var(--color-portrait-dot) var(--halftone-dot),
      transparent calc(var(--halftone-dot) + 0.2px)
    );
    background-size: var(--halftone-portrait-size) var(--halftone-portrait-size);
    pointer-events: none;
  }

  .role {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: max-content;
    margin-top: var(--space-5);
    padding: var(--space-2) var(--space-3);
    border: var(--rule-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-note);
  }

  .avail i {
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-green);
  }

  .nav {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-7);
    font-size: var(--text-nav);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-body);
  }

  .nav a {
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .nav a[aria-current='true'] {
    color: var(--color-gold-deep);
  }

  .contact {
    margin-top: auto;
    padding-top: var(--space-6);
    font-style: normal;
    font-size: var(--text-note);
    line-height: var(--leading-body);
  }

  .contact a {
    text-decoration: none;
  }

  .contact a:hover {
    text-decoration: underline;
  }

  /* Below the desktop breakpoint the compact header carries the portrait, the menu and
     the contact links, so the column keeps only the name, the role and the pill. */
  @media (max-width: 1023px) {
    .portrait,
    .nav,
    .contact {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .name {
      font-size: var(--text-name-phone);
    }
  }
</style>
