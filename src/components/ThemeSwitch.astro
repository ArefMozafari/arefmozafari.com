---
/**
 * The colour-scheme switch: three buttons, system, light, dark, each setting its scheme
 * directly. The pressed one is marked for sighted and assistive readers alike. Wired by
 * scripts/theme.ts.
 */
const OPTIONS = [
  { id: 'system', label: 'System' },
  { id: 'light', label: 'Light' },
  { id: 'dark', label: 'Dark' },
] as const;
---

<fieldset class="switch mono" data-theme-switch>
  <legend class="visually-hidden">Colour scheme</legend>
  {OPTIONS.map((option) => (
    <button
      type="button"
      data-theme-option={option.id}
      aria-pressed={option.id === 'system' ? 'true' : 'false'}
    >
      {option.label}
    </button>
  ))}
</fieldset>

<style>
  .switch {
    display: inline-flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .switch button {
    padding: var(--space-1) var(--space-2);
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  /* The pressed option takes the ink and the gold underline of a link: at label size, gold
     text alone on cream falls short of 4.5:1. */
  .switch button[aria-pressed='true'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-deep);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }
</style>
