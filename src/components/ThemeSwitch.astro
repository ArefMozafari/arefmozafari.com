---
/// The colour-scheme switch: three buttons, system, light, dark, each setting its scheme
/// directly. The pressed one is marked for sighted and assistive readers alike. Wired by
/// scripts/theme.ts.
const OPTIONS = [
  { id: 'system', label: 'System' },
  { id: 'light', label: 'Light' },
  { id: 'dark', label: 'Dark' },
] as const;
---

<fieldset class="switch mono" data-theme-switch>
  <legend class="legend">Colour scheme</legend>
  {OPTIONS.map((option) => (
    <button
      type="button"
      data-theme-option={option.id}
      aria-pressed={option.id === 'system' ? 'true' : 'false'}
    >
      {option.label}
    </button>
  ))}
</fieldset>

<style>
  .switch {
    display: inline-flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Read by assistive technology, not drawn. */
  .legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .switch button {
    padding: var(--space-1) var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: none;
    font: inherit;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .switch button[aria-pressed='true'] {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
</style>
