---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import portrait from '../assets/portrait.jpg';
import { THEME_KEY } from '../scripts/theme';
import { SITE } from '../site';

/// A share image with the dimensions and alt text that card scrapers read.
interface ShareImage {
  src: string;
  width: number;
  height: number;
  alt: string;
}

/// A post page: adds the article tags and a BlogPosting node by the owner.
interface Article {
  title: string;
  date: Date;
  image: ShareImage;
}

interface Props {
  title: string;
  description: string;
  article?: Article;
  /// Pages that must not be indexed, such as the 404, get the robots tag and no canonical.
  noindex?: boolean;
}

const SITE_CARD: ShareImage = { src: '/og.png', width: 1200, height: 630, alt: SITE.description };
const PORTRAIT_WIDTH = 640;

const { title, description, article, noindex = false } = Astro.props;
const origin = Astro.site ?? SITE.domain;
const canonical = new URL(Astro.url.pathname, origin).href;
const shareImage = article?.image ?? SITE_CARD;
const shareImageUrl = new URL(shareImage.src, origin).href;
const publishedOn = article?.date.toISOString().slice(0, 10);

const portraitImage = await getImage({ src: portrait, width: PORTRAIT_WIDTH, format: 'jpeg' });
const personId = `${SITE.domain}/#person`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.name,
  alternateName: SITE.nameFa,
  jobTitle: SITE.title,
  description: SITE.description,
  url: `${SITE.domain}/`,
  image: new URL(portraitImage.src, origin).href,
  email: `mailto:${SITE.email}`,
  knowsAbout: SITE.knowsAbout,
  sameAs: [SITE.linkedin, SITE.github, ...SITE.profiles],
};
const website = {
  '@type': 'WebSite',
  url: `${SITE.domain}/`,
  name: SITE.name,
  publisher: { '@id': personId },
};
const posting = article && {
  '@type': 'BlogPosting',
  headline: article.title,
  description,
  datePublished: publishedOn,
  image: shareImageUrl,
  url: canonical,
  mainEntityOfPage: canonical,
  author: { '@id': personId },
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [person, website, posting].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline define:vars={{ themeKey: THEME_KEY }}>
      // Applies a stored scheme before first paint so the page never flashes the other one.
      try {
        const stored = localStorage.getItem(themeKey);
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        // No storage, no stored choice: the system scheme applies.
      }
    </script>
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={SITE.themeColor.light}
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={SITE.themeColor.dark} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    {article && (
      <>
        <meta property="article:published_time" content={publishedOn} />
        <meta property="article:author" content={SITE.linkedin} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <Font cssVariable="--font-display" preload />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/years-client';
      import '../scripts/active-nav';
      import '../scripts/theme';
      import '../scripts/demo-start';
    </script>
  </body>
</html>
