---
import Shell from '../components/Shell.astro';
import Base from '../layouts/Base.astro';
import { yearsSince } from '../lib/years';
import { SITE } from '../site';

const years = yearsSince(SITE.careerStart, new Date());
---

<Base title={`${SITE.name} · ${SITE.title}`} description={SITE.description}>
  <Shell years={years}>
    <section id="work">
      <p class="lead">Three things I shipped that you can open right now.</p>
    </section>
  </Shell>
</Base>
